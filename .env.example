# Hindsight on Dokploy - environment template.
# Copy these into the Dokploy "Environment" tab for the Compose service.
# Do NOT commit real secrets. Values marked (secret) should be masked in Dokploy.

# --- LLM (required) ---------------------------------------------------------
# Provider: openai | anthropic | gemini | groq | ollama | lmstudio | minimax | atlas | deepseek | zai | vertexai | volcano
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=sk-xxxxx            # (secret) REQUIRED
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
# HINDSIGHT_API_LLM_BASE_URL=https://api.openai.com/v1   # only for custom / OpenAI-compatible endpoints

# --- Database (password required) ------------------------------------------
HINDSIGHT_DB_PASSWORD=change-me               # (secret) REQUIRED
HINDSIGHT_DB_USER=hindsight_user
HINDSIGHT_DB_NAME=hindsight_db

# --- Control Plane UI auth (strongly recommended) --------------------------
HINDSIGHT_CP_ACCESS_KEY=change-me-too         # (secret) gates the UI login page

# --- MCP endpoint auth (optional) ------------------------------------------
# Requires this bearer token on the /mcp endpoint. NOTE: the REST API has NO
# built-in auth - keep it private or front it with Traefik Basic Auth (README).
# HINDSIGHT_API_MCP_AUTH_TOKEN=

# --- Image version (recommended to pin) ------------------------------------
# Default is :latest. Pin to a released tag for production. Verify the exact tag at
# https://github.com/vectorize-io/hindsight/pkgs/container/hindsight (e.g. 0.8.3).
# HINDSIGHT_VERSION=0.8.3
